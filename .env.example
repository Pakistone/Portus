# ==============================================================================
# PORTUS — U.J.P.A.S. PRODUCTION CONFIGURATION TEMPLATE
# Union des Jeunes du Port pour l'Assistance et la Sécurité
# Zone Portuaire & Industrielle d'Abidjan
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND-SAFE VARIABLES (Exposées au navigateur via Vite)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NE JAMAIS EXPOSER AU CLIENT WEB OU VITE)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Clé secrète de service Supabase (accès admin privilégié côté serveur)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Clé secrète maître HMAC-SHA256 pour signature inviolable des QR codes (OBLIGATOIRE EN PROD >= 32 chars)
# Générer une clé sécurisée avec : openssl rand -hex 32
PORTUS_HMAC_SECRET=
PORTUS_BOOTSTRAP_ADMIN_EMAILS=ypaki090@gmail.com,admin@portus-ujpas.online
ALLOW_DATABASE_RESET=false
